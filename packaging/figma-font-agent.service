[Unit]
Description=Figma font agent (serve system fonts to Figma in the browser)
Documentation=https://github.com/hominluo/figma-font-installer-for-linux
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/figma-font-agent
Restart=on-failure
RestartSec=2
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# The agent only reads fonts and fontconfig's cache.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-%h/.cache/fontconfig

[Install]
WantedBy=default.target
