# Maintainer: Homin Luo <homin.ro@gmail.com>
pkgname=figma-font-agent
pkgver=0.2.1
pkgrel=1
pkgdesc='Serve system fonts to Figma in the browser (open Figma Agent reimplementation)'
arch=('x86_64' 'aarch64')
url='https://github.com/hominluo/figma-font-installer-for-linux'
license=('MIT')
depends=('gcc-libs' 'fontconfig')
makedepends=('cargo' 'rust')
options=('!lto' '!debug') # the release profile already enables LTO and strips
_archive="$url/archive/v$pkgver.tar.gz"
source=("$pkgname-$pkgver.tar.gz::$_archive")
sha256sums=('99ed6ddca2f506eaa3eae3cdf62a627cbf96d6a292c7b1f4c44afd2135a5f883')

build() {
    cd "$srcdir/figma-font-installer-for-linux-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$srcdir/figma-font-installer-for-linux-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$srcdir/figma-font-installer-for-linux-$pkgver"

    install -Dm755 target/release/figma-font-agent \
        "$pkgdir/usr/bin/figma-font-agent"

    install -Dm644 packaging/figma-font-agent.service \
        "$pkgdir/usr/lib/systemd/user/figma-font-agent.service"
    install -Dm644 packaging/figma-font-agent.socket \
        "$pkgdir/usr/lib/systemd/user/figma-font-agent.socket"

    install -Dm644 docs/figma-font-agent.1 \
        "$pkgdir/usr/share/man/man1/figma-font-agent.1"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/protocol.md "$pkgdir/usr/share/doc/$pkgname/protocol.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
